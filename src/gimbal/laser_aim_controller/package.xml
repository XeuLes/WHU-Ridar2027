<?xml version="1.0"?>
<package format="3">
  <name>laser_aim_controller</name>
  <version>0.0.1</version>
  <description>Laser aiming controller based on auto aim target pose and realtime gimbal state.</description>

  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>

  <depend>auto_aim_fast</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>