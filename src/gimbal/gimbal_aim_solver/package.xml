<?xml version="1.0"?>
<package format="3">
  <name>gimbal_aim_solver</name>
  <version>0.0.1</version>
  <description>Convert UAV world positions into gimbal target yaw/pitch angles.</description>

  <maintainer email="user@todo.todo">user</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>radar_decision_comm</depend>
  <exec_depend>gimbal_serial_bridge</exec_depend>
  <exec_depend>localization</exec_depend>

  <build_depend>eigen3_cmake_module</build_depend>
  <depend>eigen</depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
